{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "build": "vite build",
    "postinstall": "npm run prisma:generate --workspace=@lumenfield/db --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@lumenfield/db",
    "test": "vitest run apps/api/tests --test-timeout 15000",
    "test:e2e": "vitest run apps/api/tests/e2e-journey.spec.ts",
    "audit": "npm audit --audit-level=high || true",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed": "tsx packages/db/src/seed.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.34.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "typescript": "~5.9.3"
  }
}
