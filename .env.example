# ==============================================================================
# LUMENFIELD ENVIRONMENT CONFIGURATION
# Private Financial Sandbox & Wallet Platform
# ==============================================================================
# NOTE: All balances in sandbox mode are test funds, not real money.
# Copy this file to .env before starting the development stack.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & PLATFORM SAFETY FLAGS
# ------------------------------------------------------------------------------
# Runtime environment: development | test | staging | production
NODE_ENV="development"

# Port for the NestJS API application (apps/api)
PORT=3001

# Port for the Web client / frontend (apps/web)
WEB_PORT=3000

# Official public website (email verification & password-reset links)
APP_URL="https://www.lumenfieldcu.com"
API_URL="https://www.lumenfieldcu.com"

# Official support / admin contact email
SUPPORT_EMAIL="support@lumenfieldcu.com"

# SANDBOX_MODE=true enables demo shortcuts (auto-verify email, MFA hints, reset tokens).
# Set false for live auth with Resend email verification & password reset.
SANDBOX_MODE=false

# PRODUCTION_MODE requires real deposit reference & second approver for funding.
# Keep false until charter/partner bank requirements are complete.
PRODUCTION_MODE=false

# HARD RULE 5: REQUIRE_SECOND_APPROVER enforces dual-control approval on admin operations.
# Default: false (set to true in production or regulated staging).
REQUIRE_SECOND_APPROVER=false

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & CACHING (NEON POSTGRESQL & REDIS)
# ------------------------------------------------------------------------------
# Recommended (pooled) — app runtime / Prisma queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Direct connection (no PgBouncer) — migrations / long-lived admin jobs
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon connection parameters
PGHOST=""
PGHOST_UNPOOLED=""
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD=""

# Vercel / Neon Postgres template aliases
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER="neondb_owner"
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE="neondb"
POSTGRES_URL_NO_SSL=""
POSTGRES_PRISMA_URL=""

# Redis Connection URL (for BullMQ queues, rate limiting, and session cache)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT, ARGON2, MFA)
# ------------------------------------------------------------------------------
# Secret key used to sign member and admin access JWT tokens (min 32 chars)
JWT_SECRET="lumenfield_dev_super_secret_jwt_access_key_2026_at_least_32_chars"
JWT_EXPIRES_IN="15m"

# Secret key used to sign refresh tokens
JWT_REFRESH_SECRET="lumenfield_dev_super_secret_jwt_refresh_key_2026_at_least_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Argon2 Password Hashing parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Multi-Factor Authentication (TOTP issuer name displayed in authenticator apps)
TOTP_ISSUER="Lumenfield Credit Union"

# Seeded SUPER_ADMIN (used by AuthService on boot — set a strong unique password)
# REQUIRED on Vercel/production or admin login fails. Avoid "#" in the password (env parsers truncate).
# After adding/changing these in Vercel, Redeploy — "Needs Attention" means not applied yet.
SUPER_ADMIN_EMAIL="support@lumenfieldcu.com"
SUPER_ADMIN_PASSWORD=""
# Optional: fixed authenticator secret (Base32). If unset, one is derived from JWT_SECRET.
# SUPER_ADMIN_TOTP_SECRET=""

# ------------------------------------------------------------------------------
# 4. PRIVATE DOCUMENT STORAGE (S3-COMPATIBLE BUCKET)
# ------------------------------------------------------------------------------
# HARD RULE 7: KYC documents go to a PRIVATE storage bucket, encrypted,
# accessed ONLY through short-lived signed URLs by SUPER_ADMIN. Never public.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET_NAME="lumenfield-private-documents"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minio_admin"
STORAGE_SECRET_KEY="minio_sandbox_secret"
STORAGE_SIGNED_URL_EXPIRES_IN=300
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. RATE LIMITING & SECURITY HEADERS
# ------------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS="https://www.lumenfieldcu.com,http://www.lumenfieldcu.com,http://localhost:3000,http://localhost:3001,http://localhost:5175"

# ------------------------------------------------------------------------------
# 6. EMAIL (RESEND)
# ------------------------------------------------------------------------------
# Get your API key at https://resend.com/api-keys
# Verify lumenfieldcu.com in Resend before sending from this address.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Lumenfield Credit Union <support@lumenfieldcu.com>"
RESEND_REPLY_TO="support@lumenfieldcu.com"

# ------------------------------------------------------------------------------
# 7. OPTIONAL EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Optional AI assistant/underwriting helper
GEMINI_API_KEY=""
