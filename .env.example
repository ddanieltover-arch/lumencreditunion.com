# ==============================================================================
# LUMENFIELD ENVIRONMENT CONFIGURATION
# Private Financial Sandbox & Wallet Platform
# ==============================================================================
# NOTE: All balances in sandbox mode are test funds, not real money.
# Copy this file to .env before starting the development stack.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & PLATFORM SAFETY FLAGS
# ------------------------------------------------------------------------------
# Runtime environment: development | test | staging | production
NODE_ENV="development"

# Port for the NestJS API application (apps/api)
PORT=3001

# Port for the Web client / frontend (apps/web)
WEB_PORT=3000

# Base URL for public API access and web client
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# HARD RULE 4: SANDBOX_MODE enables sandbox features (source=TEST ledger entries).
# Default: true.
SANDBOX_MODE=true

# HARD RULE 4: PRODUCTION_MODE requires real deposit reference & second approver.
# Default: false. Must remain false until official banking charter/license.
PRODUCTION_MODE=false

# HARD RULE 5: REQUIRE_SECOND_APPROVER enforces dual-control approval on admin operations.
# Default: false (set to true in production or regulated staging).
REQUIRE_SECOND_APPROVER=false

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & CACHING (POSTGRESQL & REDIS)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (packages/db & apps/api)
# Matches credentials defined in docker-compose.yml
DATABASE_URL="postgresql://lumenfield_user:lumenfield_secret_pass@localhost:5432/lumenfield_db?schema=public"

# Redis Connection URL (for BullMQ queues, rate limiting, and session cache)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT, ARGON2, MFA)
# ------------------------------------------------------------------------------
# Secret key used to sign member and admin access JWT tokens (min 32 chars)
JWT_SECRET="lumenfield_dev_super_secret_jwt_access_key_2026_at_least_32_chars"
JWT_EXPIRES_IN="15m"

# Secret key used to sign refresh tokens
JWT_REFRESH_SECRET="lumenfield_dev_super_secret_jwt_refresh_key_2026_at_least_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Argon2 Password Hashing parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Multi-Factor Authentication (TOTP issuer name displayed in authenticator apps)
TOTP_ISSUER="Lumenfield Sandbox"

# ------------------------------------------------------------------------------
# 4. PRIVATE DOCUMENT STORAGE (S3-COMPATIBLE BUCKET)
# ------------------------------------------------------------------------------
# HARD RULE 7: KYC documents go to a PRIVATE storage bucket, encrypted,
# accessed ONLY through short-lived signed URLs by SUPER_ADMIN. Never public.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET_NAME="lumenfield-private-documents"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minio_admin"
STORAGE_SECRET_KEY="minio_sandbox_secret"
STORAGE_SIGNED_URL_EXPIRES_IN=300
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. RATE LIMITING & SECURITY HEADERS
# ------------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ------------------------------------------------------------------------------
# 6. OPTIONAL EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Optional AI assistant/underwriting helper
GEMINI_API_KEY=""
