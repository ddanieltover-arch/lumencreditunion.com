{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@lumenfield/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@lumenfield/shared/*": [
        "./packages/shared/src/*"
      ],
      "@lumenfield/db": [
        "./packages/db/src/index.ts"
      ],
      "@lumenfield/db/*": [
        "./packages/db/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist", "e2e", "playwright.config.ts"]
}
