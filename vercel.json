{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/((?!assets/).*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps && npx prisma generate --schema=packages/db/prisma/schema.prisma"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/config", "destination": { "service": "api" } },
    { "source": "/countries", "destination": { "service": "api" } },
    { "source": "/countries/(.*)", "destination": { "service": "api" } },
    { "source": "/auth/(.*)", "destination": { "service": "api" } },
    { "source": "/kyc/(.*)", "destination": { "service": "api" } },
    { "source": "/wallet/(.*)", "destination": { "service": "api" } },
    { "source": "/transfers/(.*)", "destination": { "service": "api" } },
    { "source": "/cards", "destination": { "service": "api" } },
    { "source": "/cards/(.*)", "destination": { "service": "api" } },
    { "source": "/loans", "destination": { "service": "api" } },
    { "source": "/loans/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/member-directory", "destination": { "service": "api" } },
    { "source": "/admin/member-directory/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/dashboard-stats", "destination": { "service": "api" } },
    { "source": "/admin/funding", "destination": { "service": "api" } },
    { "source": "/admin/funding/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/funding-requests", "destination": { "service": "api" } },
    { "source": "/admin/funding-requests/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/fund-wallet", "destination": { "service": "api" } },
    { "source": "/admin/audit-logs", "destination": { "service": "api" } },
    { "source": "/admin/ledger/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/kyc/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/transfers/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/loans", "destination": { "service": "api" } },
    { "source": "/admin/loans/(.*)", "destination": { "service": "api" } },
    { "source": "/admin/cards", "destination": { "service": "api" } },
    { "source": "/admin/cards/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
